
digraph G {
    graph [
        rankdir=TB,
        bgcolor="white",
        pad=0.4,
        nodesep=0.4,
        ranksep=0.6,
        dpi=200
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=12,
        color="#2F5597",
        fillcolor="#EAF2F8",
        margin="0.18,0.12"
    ];

    edge [
        fontname="Arial",
        fontsize=10,
        color="#555555"
    ];

    start [
        label="Начало",
        shape=oval,
        fillcolor="#E2F0D9",
        color="#548235"
    ];

    end [
        label="Завершение",
        shape=oval,
        fillcolor="#FCE4D6",
        color="#C65911"
    ];

    n1 [
        label="Создать заказ сотрудника"
    ];

    n2 [
        label="Получить товар и количество",
        shape=parallelogram,
        fillcolor="#E4DFEC",
        color="#7030A0"
    ];

    n3 [
        label="Проверить id и name (не null/blank),\nprice > 0, quantity от 1 до 100"
    ];

    n4 [
        label="Позиция корректна?",
        shape=diamond,
        fillcolor="#FFF2CC",
        color="#BF9000"
    ];

    n5 [
        label="Товар уже есть\nв заказе?",
        shape=diamond,
        fillcolor="#FFF2CC",
        color="#BF9000"
    ];

    n10 [
        label="Позиций меньше 10?",
        shape=diamond,
        fillcolor="#FFF2CC",
        color="#BF9000"
    ];

    n11 [
        label="Отклонить новый товар:\nлимит 10 позиций",
        fillcolor="#FCE4D6",
        color="#C65911"
    ];

    n6 [
        label="Увеличить количество\nили добавить новую позицию"
    ];

    n7 [
        label="Есть ещё позиции?",
        shape=diamond,
        fillcolor="#FFF2CC",
        color="#BF9000"
    ];

    n8 [
        label="Рассчитать итог:\nsum(item.getLineTotal())"
    ];

    n9 [
        label="Проверить DRAFT и непустой заказ,\nзатем установить CONFIRMED"
    ];

    start -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> n4;

    n4 -> n2 [label="нет"];
    n4 -> n5 [label="да"];

    n5 -> n6 [label="да"];
    n5 -> n10 [label="нет"];

    n10 -> n6 [label="да"];
    n10 -> n11 [label="нет"];

    n11 -> n7;
    n6 -> n7;

    n7 -> n2 [label="да"];
    n7 -> n8 [label="нет"];

    n8 -> n9;
    n9 -> end;
}
